# Postgres connection string used by the app, migrations and seed script.
# Matches docker-compose.yml. For Supabase/Neon, paste their connection string.
DATABASE_URL=postgres://macros:macros@localhost:5432/macrosandcalorie

# Integration tests (tests/*.integration.test.ts) wipe the target database, so
# the database name MUST end in "_test". Tests are skipped when this is unset.
# TEST_DATABASE_URL=postgres://macros:macros@localhost:5432/macrosandcalorie_test

# The app has no login yet: every request acts as one built-in user. In production
# it refuses to start unless you set this, so it cannot be exposed by accident.
# Set it only on your own machine or a private network. See docs/DECISIONS.md.
# SINGLE_USER_MODE=true

# Extra hostnames allowed to open `npm run dev` (private network ranges already are),
# comma separated, e.g. a tunnel. Not needed for `npm start`.
# DEV_ALLOWED_ORIGINS=my-tunnel.example.com
